ry.split(',').map(Number);\n\n    return { x, y, z, edge, angle: Math.atan2(y, x), radius: Math.hypot(x, y) };\n  })\n  .sort((a, b) => a.angle - b.angle)\n  .map((dot, rank, all) => ({\n    ...dot,\n    slot: (rank / all.length) * TURN - Math.PI,\n  }));\n\nfunction smoother(x: number) {\n  return x * x * x * (x * (x * 6 - 15) + 10);\n}\n\nfunction morphAt(t: number) {\n  const local = t % CYCLE;\n  if (local < HOLD) return 0;\n  if (local < HOLD + MORPH) return smoother((local - HOLD) / MORPH);\n  if (local < HOLD + MORPH + SPIN) return 1;\n\n  return smoother(1 - (local - HOLD - MORPH - SPIN) / MORPH);\n}\n\nfunction frameAt(size: number, t: number) {\n  const center = size / 2;\n  const scale = center * 0.82;\n  const radiusScale = (size / 300) ** 0.6;\n  const morph = morphAt(t);\n  const alpha = 1 - 0.25 * Math.sin(Math.PI * morph);\n\n  return markDots\n    .map((dot): TDot => {\n      const swirl = dot.slot + t * (3 - 2 * dot.radius);\n      const swirlRadius = 0.2 + dot.radius * 0.55;\n      const x = dot.x + (Math.cos(swirl) * swirlRadius - dot.x) * morph;\n      const y = dot.y + (Math.sin(swirl) * swirlRadius - dot.y) * morph;\n      const z = dot.z + (0.15 * Math.sin(swirl * 2) - dot.z) * morph;\n      const depth = Math.min(1, Math.max(0, (z + 1) / 2));\n\n      return {\n        x: center + x * scale,\n        y: center - y * scale,\n        z,\n        r: Math.max(0.3, (0.55 + 1.5 * depth) * radiusScale),\n        white: 0.6 - 0.5 * depth - 0.16 * (1 - dot.edge),\n        alpha,\n      };\n    })\n    .sort((a, b) => a.z - b.z);\n}\n\nfunction paintDots(\n  ctx: CanvasRenderingContext2D,\n  dots: TDot[],\n  isDark: boolean\n) {\n  const ink = isDark ? INK.dark : INK.light;\n  for (const dot of dots) {\n    const white = Math.min(1, Math.max(0, dot.white));\n    const value = isDark ? 1 - white : white;\n    const channel = (c: number) =>\n      Math.round(isDark ? c * value : 255 + (c - 255) * (1 - value));\n    ctx.fillStyle = `rgba(${channel(ink.r)},${channel(ink.g)},${channel(ink.b)},${dot.alpha})`;\n    ctx.beginPath();\n    ctx.arc(dot.x, dot.y, dot.r, 0, TURN);\n    ctx.fill();\n  }\n}\n\nfunction useIsDark() {\n  const [isDark, setIsDark] = React.useState(false);\n\n  React.useEffect(() => {\n    const el = document.documentElement;\n    const update = () => setIsDark(el.classList.contains('dark'));\n    update();\n    const observer = new MutationObserver(update);\n    observer.observe(el, { attributes: true, attributeFilter: ['class'] });\n\n    return () => observer.disconnect();\n  }, []);\n\n  return isDark;\n}\n\nfunction FormanceThinkingLogo({\n  size = 32,\n  className,\n  style,\n  ...props\n}: TFormanceThinkingLogoProps) {\n  const ref = React.useRef<HTMLCanvasElement>(null);\n  const startedAt = React.useRef<number | null>(null);\n  const isDark = useIsDark();\n\n  React.useEffect(() => {\n    const canvas = ref.current;\n    const ctx = canvas?.getContext('2d');\n    if (!canvas || !ctx) return;\n\n    const dpr = Math.min(2, window.devicePixelRatio || 1);\n    canvas.width = Math.round(size * dpr);\n    canvas.height = Math.round(size * dpr);\n\n    const render = (t: number) => {\n      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n      ctx.clearRect(0, 0, size, size);\n      paintDots(ctx, frameAt(size, t), isDark);\n    };\n\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      render(0);\n\n      return;\n    }\n\n    startedAt.current ??= performance.now();\n    const elapsed = (now: number) => (now - (startedAt.current ?? now)) / 1000;\n\n    let frame = 0;\n    let running = false;\n    let visible = true;\n\n    const loop = (now: number) => {\n      render(elapsed(now));\n      if (running) frame = requestAnimationFrame(loop);\n    };\n    const start = () => {\n      if (running) return;\n      running = true;\n      frame = requestAnimationFrame(loop);\n    };\n    const stop = () => {\n      running = false;\n      cancelAnimationFrame(frame);\n    };\n\n    render(elapsed(performance.now()));\n\n    const intersection = new IntersectionObserver((entries) => {\n      visible = entries.some((entry) => entry.isIntersecting);\n      if (visible && document.visibilityState !== 'hidden') start();\n      else stop();\n    });\n    intersection.observe(canvas);\n\n    const onVisibilityChange = () => {\n      if (document.visibilityState === 'hidden') stop();\n      else if (visible) start();\n    };\n    document.addEventListener('visibilitychange', onVisibilityChange);\n\n    return () => {\n      stop();\n      intersection.disconnect();\n      document.removeEventListener('visibilitychange', onVisibilityChange);\n    };\n  }, [size, isDark]);\n\n  return (\n    <canvas\n      ref={ref}\n      role=\"img\"\n      aria-label=\"Thinking\"\n      className={cn('block shrink-0', className)}\n      style={{ width: size, height: size, ...style }}\n      {...props}\n    />\n  );\n}\n\nexport { FormanceThinkingLogo };\nexport type { TFormanceThinkingLogoProps };\n",
