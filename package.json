{
  "name": "@formance/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless design-system next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "lint": "eslint --cache",
    "react-doctor": "npx --yes react-doctor@latest --yes --scope full --blocking error",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier \"**/*.{ts,tsx,md,json}\" --check",
    "format:fix": "prettier \"**/*.{ts,tsx,md,json}\" --write",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check:docs": "tsx scripts/check-docs-integrity.ts",
    "registry:build": "shadcn build",
    "schemas:validate": "node scripts/validate-ledger-schema.mjs",
    "extract:operations": "tsx scripts/extract-stack-operations.ts",
    "extract:membership-operations": "tsx scripts/extract-membership-operations.ts",
    "pre-commit": "lint-staged && pnpm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@next/third-parties": "^16.3.3",
    "@shikijs/monaco": "^4.4.3",
    "@tanstack/react-table": "^9.2.4",
    "@types/mdx": "^2.0.14",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "mermaid": "^11.17.2",
    "monaco-editor-core": "^0.56.0",
    "next": "^16.3.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "portless": "0.13.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
